{
  "name": "paper-plane-yard",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "matter-js": "^0.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/matter-js": "^0.20.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "doctor": "expo-doctor",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:run": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sim:build": "tsc --ignoreConfig src/game/constants.ts src/game/rng.ts src/game/levelGen.ts src/game/physics.ts --outDir .sim --module commonjs --target es2020 --skipLibCheck --esModuleInterop",
    "sim": "npm run --silent sim:build && node tools/simulate.js",
    "probe": "npm run --silent sim:build && node tools/probe.js",
    "update": "npx eas-cli update --branch production --platform all",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:ios:store": "npx eas-cli build --platform ios --profile production",
    "build:ios:local": "npx eas-cli build --platform ios --profile production --local",
    "submit:ios": "npx eas-cli submit --platform ios --profile production",
    "ios:xcode": "expo prebuild --platform ios"
  },
  "private": true
}
